# Install with: sudo install -m 0440 -o root -g root iso-build/sudoers.d/acme-msp-console /etc/sudoers.d/acme-msp-console
# Always validate with: sudo visudo -c -f /etc/sudoers.d/acme-msp-console
#
# Grants the UNPRIVILEGED acme-msp-console service account (which runs
# the always-on, network-facing MSP Console dashboard) the ability to
# run exactly five specific, pre-defined command shapes -- and nothing
# else. This is the ONLY root-equivalent capability given to that
# account, mirroring the SAME narrow-sudoers philosophy already used for
# the single-instance profile's acme-appliance service account (see
# iso-build/sudoers.d/acme-appliance-updates), extended here to permit
# one validated parameter (a customer slug, and for the log-tail command
# a line count) per rule rather than zero parameters.
#
# The console's Python code (msp_console/actions.py) validates every
# slug against the exact same regex/length rule as
# bin/msp-provision-customer.sh BEFORE ever constructing any of the
# commands below, and always invokes them via an explicit argv list
# (never a shell), so the wildcards below are matched against an
# argument that was already constrained long before sudo ever sees it --
# this is defense in depth, not the only line of defense.
#
# IMPORTANT: the argument order and flags below must match
# msp_console/actions.py's subprocess calls EXACTLY, in the same order,
# or sudo will simply refuse the request (fails closed). If you change
# one side, you MUST change the other.
#
# Read-only systemd queries (systemctl is-active / is-enabled) are
# DELIBERATELY not listed here -- querying unit status is not a
# privileged operation under systemd's default policy (the same is true
# of the existing system_updates.py's own is_check_in_progress() /
# is_update_in_progress() calls, which also run without sudo), so no
# sudoers rule is needed or granted for those reads.

# Customer lifecycle -- delegates to the already argument-validating
# scripts under bin/, unchanged from their CLI-invoked form except that
# deprovision requires --yes here (no TTY exists to prompt on; the
# console performs its own confirmation step in the web UI before ever
# reaching this call).
acme-msp-console ALL=(root) NOPASSWD: /opt/acme-appliance/bin/msp-provision-customer.sh *
acme-msp-console ALL=(root) NOPASSWD: /opt/acme-appliance/bin/msp-deprovision-customer.sh * --yes

# Per-customer systemd actions. --no-block on the renewal trigger is
# required -- certbot + DNS propagation waits can take minutes, far
# longer than is reasonable to hold a web request open for; without
# --no-block, "systemctl start" on this Type=oneshot unit blocks until
# the whole renewal finishes.
acme-msp-console ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block acme-renew@*.service
acme-msp-console ALL=(root) NOPASSWD: /usr/bin/systemctl restart acme-webui@*.service

# Read a customer's own log file as root -- that file is owned 0600 by
# the customer's OWN dedicated system account (acmecust-<slug>), which
# the console's account correctly has no direct read access to; this is
# the one sanctioned, narrow way to cross that boundary for display
# purposes only (see bin/msp-tail-log.sh, which itself re-validates the
# slug and clamps the line count before reading anything).
acme-msp-console ALL=(root) NOPASSWD: /opt/acme-appliance/bin/msp-tail-log.sh *
