# ACME + Palo Alto appliance configuration
# Copy to /etc/acme-appliance/appliance.yaml and fill in real values, OR
# just use the web UI (see webui/) to manage this file -- it reads and
# writes this exact structure.
# File permissions should be 0600, owned by the service account (contains secrets).

acme:
  email: "netops@example.com"
  # Let's Encrypt production endpoint. Point at the staging endpoint
  # (https://acme-staging-v02.api.letsencrypt.org/directory) while testing
  # to avoid production rate limits.
  server: "https://acme-v02.api.letsencrypt.org/directory"

# Named DNS provider *instances*. You can have more than one instance of
# the same type (e.g. two Cloudflare accounts, two Azure subscriptions) --
# each instance name is arbitrary and is referenced by domains[].dns_provider.
dns_providers:
  azure-hoffman-net:
    type: azure
    settings:
      tenant_id: "CHANGE-ME"
      sp_client_id: "CHANGE-ME"
      sp_client_secret: "CHANGE-ME"
      subscription_id: "CHANGE-ME"
      resource_group: "DNS_Resource_Group"
      zone: "hoffman.net"
      propagation_seconds: 45

  cloudflare-main:
    type: cloudflare
    settings:
      api_token: "CHANGE-ME"
      propagation_seconds: 20

  route53-main:
    type: route53
    settings:
      hosted_zone_id: "CHANGE-ME"
      region: "us-east-1"
      # Omit access key/secret to use the instance/role credential chain.

  internal-dns-shim:
    type: generic_webhook
    settings:
      add_url: "https://dns-shim.internal.example.com/api/txt/add"
      remove_url: "https://dns-shim.internal.example.com/api/txt/remove"
      auth_header: "Bearer CHANGE-ME"

# One entry per Palo Alto firewall the appliance is allowed to update.
# IMPORTANT: the admin account (or the account behind the API key) must
# use a custom Admin Role with ALL FOUR of these enabled under
# Device > Admin Roles > <role> > XML API tab:
#   - Configuration          (get/set SSL/TLS profile, list/delete certs)
#   - Import                 (upload the certificate + key)
#   - Commit                  (commit the change)
#   - Operational Requests    (needed only for the web UI's "Test connection"
#                              button -- deployment itself works without it,
#                              but Test connection will fail without it)
panos_firewalls:
  hq-firewall:
    hostname: "10.10.10.1"
    # Prefer a long-lived API key generated once via:
    #   https://<fw>/api/?type=keygen&user=<user>&password=<pass>
    api_key: "CHANGE-ME"
    verify_tls: false
    cleanup_old_certs: true

  branch-firewall:
    hostname: "10.20.10.1"
    api_key: "CHANGE-ME"
    verify_tls: false
    cleanup_old_certs: true

# One entry per certificate you want the appliance to manage. Each entry
# produces ONE certificate; `panos_targets` lists everywhere that
# certificate should be deployed, and each target can use its own
# SSL/TLS Service Profile (or GlobalProtect portal cert field) -- so
# different domains, or even different targets on the SAME domain, can
# each be assigned their own specific profile.
domains:
  - name: "vpn.example.com"
    dns_provider: "azure-hoffman-net"    # must match a key in dns_providers above
    cert_name_prefix: "gp-portal-cert"   # appliance appends a date/time stamp
    panos_targets:
      - firewall: "hq-firewall"          # must match a key in panos_firewalls above
        ssl_tls_profile: "SSL-GP-Portal"
        # OR, if you set the cert directly on the portal instead of a profile:
        # globalprotect_portal: "gp-portal"

  - name: "vpn2.example.com"
    dns_provider: "cloudflare-main"
    cert_name_prefix: "gp-portal-cert"
    panos_targets:
      - firewall: "branch-firewall"
        ssl_tls_profile: "SSL-GP-Portal"

  # Example wildcard certificate. Combining a wildcard with its bare apex
  # domain on ONE certificate (common, since it covers "anything.example.com"
  # plus "example.com" itself) is done via `additional_names`.
  - name: "*.example.com"
    additional_names:
      - "example.com"
    dns_provider: "azure-hoffman-net"
    cert_name_prefix: "wildcard-example-com"
    panos_targets:
      - firewall: "hq-firewall"
        ssl_tls_profile: "SSL-Wildcard-Example"
