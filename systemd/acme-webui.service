[Unit]
Description=ACME Appliance Web UI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=acme-appliance
Group=acme-appliance
WorkingDirectory=/opt/acme-appliance/webui
Environment=ACME_APPLIANCE_CONFIG=/etc/acme-appliance/appliance.yaml
Environment=ACME_APPLIANCE_USERS=/etc/acme-appliance/users.yaml
Environment=ACME_APPLIANCE_SECRET_KEY_FILE=/etc/acme-appliance/webui_secret_key
Environment=ACME_APPLIANCE_LOG=/var/log/acme-appliance.log
ExecStart=/opt/acme-appliance/venv/bin/gunicorn \
    --bind 0.0.0.0:8443 \
    --certfile /etc/acme-appliance/webui-tls/webui.crt \
    --keyfile /etc/acme-appliance/webui-tls/webui.key \
    --workers 1 \
    --timeout 120 \
    app:app
Restart=on-failure
RestartSec=5

# IMPORTANT: when the "Run renewal now" / per-domain "Renew now" buttons
# trigger bin/acme-renew.sh, that script (and the certbot process it
# spawns) runs as a CHILD of this service and therefore inherits THIS
# unit's sandboxing, not acme-renew.service's. certbot needs write access
# to its appliance-owned config/work/logs directories (see the comment in
# bin/acme-renew.sh) -- /var/lib/acme-appliance must be listed here too,
# or web-UI-triggered renewals fail before certbot can even create its
# own log file, while the separate daily-timer path (acme-renew.service)
# appears to work fine, which is a very confusing failure mode to debug.
ProtectSystem=strict
ReadWritePaths=/var/log /etc/acme-appliance /var/run /var/lib/acme-appliance
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
